[Unit]
Description=Safe View database backup

[Service]
Type=oneshot
User=safeview
Group=safeview
WorkingDirectory=/opt/safe-view
EnvironmentFile=/etc/safe-view.env
ExecStart=/usr/bin/node scripts/backup.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/safe-view
