[Unit]
Description=Safe View website and dashboard
After=network.target

[Service]
User=safeview
Group=safeview
WorkingDirectory=/opt/safe-view
EnvironmentFile=/etc/safe-view.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/safe-view

[Install]
WantedBy=multi-user.target
