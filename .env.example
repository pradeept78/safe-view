# Copy to .env on the server. deploy/docker-setup.sh writes this for you.
DOMAIN=yourdomain.in
DATA_DIR=/var/lib/safe-view

# Optional: email alerts for new enquiries. Leave these out to keep alerts off.
# For Gmail, use an App Password, not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-app-password
# ALERT_EMAIL=where-alerts-go@gmail.com
